\begin_layout Standard
Notation used,
 and in many cases defined,
 in the article...
 except for 
\begin_inset Formula $Crit(f_{\lambda,\mu})$
\end_inset

.
\begin_inset Formula 
\[
\begin{array}{lcl}
\mathbb{C} & := & \mathrm{Complex\,plane}\\
\bar{\mathbb{C}} & := & \mathrm{Riemann\,sphere}\\
J(f) & := & \mathrm{Julia\,set}\\
F(f) & := & \mathrm{Fatou\,set}\\
\mathcal{M} & := & \mathrm{Meromorphic\,class}\\
\mathcal{S} & := & \mathrm{Speisser\,class}\\
\mathcal{B} & := & \mathrm{Eremenko-Lyubich\,class}\\
f_{\lambda,\mu}(z) & := & \lambda e^{z}+\frac{\mu}{z}\\
f & := & f_{-20,1/4}\,\mathrm{[Theorem\,A]}\\
\mathcal{D} & := & \{(\lambda,\mu)\in\mathbb{C}^{2}:\,Re(\lambda)<0\,\,\text{and}\,\,|Im(\lambda)|<\frac{1}{2}|Re(\lambda)|,\,\,\mu\neq0\}\\
\mathcal{D}' & := & \mathbb{R}^{-}\times\mathbb{R}^{+}\\
F_{0} & := & \mathrm{Baker\,domain\,with\,}0\in\partial F_{0}\\
F_{\infty} & := & f_{\lambda,\mu}(F_{0})\\
Crit(f_{\lambda,\mu}) & := & \left\{ c\in\mathbb{C}:\,f'_{\lambda,\mu}(c)=0\right\} \\
c_{1} & := & c_{1}(\lambda,\mu)\in Crit(f_{\lambda,\mu})\,\mathrm{with\,minimal\,module\,and\,}Re(c_{1})>0\\
c_{-1} & := & \overline{c_{1}}\\
c_{k} & := & c_{k}(\lambda,\mu)\in Crit(f_{\lambda,\mu})-\left\{ c_{1},c_{-1}\right\} ,\,k\in\mathbb{Z}-\left\{ 1,0,-1\right\} \\
c_{-k} & := & \overline{c_{k}}\\
U & := & \left\{ (\lambda,\mu)\in\mathcal{D}':\,F_{0},F_{\infty}\,\mathrm{are\,infinitely\,connected}\right\} \,\mathrm{[Theorem\,B]}\\
A & := & \left\{ (\lambda,\mu)\in\mathcal{D}':\,F_{0},F_{\infty}\,\mathrm{are\,simply\,connected,\,}|Per_{attr}(f_{\lambda,\mu})|=4,\,\mathrm{and}\,\text{f_{\lambda,\mu}^{N}}(c_{k})\in F_{\infty}\right\} \,\mathrm{[Theorem\,C]}\\
\mathbb{B} & := & \{(\lambda,\mu)\in\mathcal{D}':\,F_{0}\cap Crit(f_{\lambda,\mu})\neq\emptyset\}\,\mathrm{[Proof\,Theorem\,B]}\\
B & := & \mathrm{Component\,of\,}\mathbb{B}\,\mathrm{such\,that\,}(-20,1/4)\in B\\
B((\lambda_{0},\mu_{0}),r) & := & \left\{ (\lambda,\mu)\in\mathcal{D}':\,||(\lambda,\mu)-(\lambda_{0},\mu_{0})||<r\right\} 
\end{array}
\]

\end_inset


