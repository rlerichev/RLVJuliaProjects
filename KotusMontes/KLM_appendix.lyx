\[
\ensuremath{\mathbb{M}_{1}=\{(\lambda,\mu)\in\mathbb{R}^{-}\times\mathbb{R}^{+}|\,\,o(c_{1}(\lambda,\mu),f_{\lambda,\mu})\,\,\mathrm{is\,bounded}\}.}
\]

\end_inset


\end_layout

